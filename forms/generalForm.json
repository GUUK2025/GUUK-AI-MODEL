{
  "formId": "general",
  "title": "General Purpose Form",
  "sheetName": "General",
  "fields": [
    {
      "name": "recordId",
      "label": "Record ID",
      "type": "text",
      "isId": true,
      "required": true,
      "readonlyOnEdit": true
    },
    {
      "name": "submissionTimestamp",
      "label": "Submission Time",
      "type": "datetime-local",
      "autoPopulate": "datetime",
      "required": true,
      "readonlyOnEdit": true
    },
    {
      "name": "recordDate",
      "label": "Date of Record",
      "type": "date",
      "autoPopulate": "date",
      "required": true
    },
    {
      "name": "category",
      "label": "Category/Purpose",
      "type": "text",
      "required": true,
      "placeholder": "e.g., Meeting Minutes, Site Visit, Community Feedback"
    },
    {
      "name": "subject",
      "label": "Subject/Title",
      "type": "text",
      "required": true
    },
    {
      "name": "details",
      "label": "Details/Content",
      "type": "textarea"
    },
    {
      "name": "customField1",
      "label": "Custom Field 1 (Text)",
      "type": "text"
    },
    {
      "name": "customField2",
      "label": "Custom Field 2 (Numeric)",
      "type": "number"
    },
    {
      "name": "customField3",
      "label": "Custom Field 3 (Select)",
      "type": "select",
      "options": ["", "Option A", "Option B", "Option C"]
    },
    {
      "name": "recordedBy",
      "label": "Recorded By",
      "type": "text",
      "fromUser": "userNameDisplay",
      "readonly": true
    }
  ]
}
