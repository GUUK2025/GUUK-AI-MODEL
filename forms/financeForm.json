{
  "formId": "finance",
  "title": "Financial Transaction Record",
  "sheetName": "Finance",
  "fields": [
    {
      "name": "transactionId",
      "label": "Transaction ID",
      "type": "text",
      "isId": true,
      "required": true,
      "readonlyOnEdit": true
    },
    {
      "name": "submissionTimestamp",
      "label": "Submission Time",
      "type": "datetime-local",
      "autoPopulate": "datetime",
      "required": true,
      "readonlyOnEdit": true
    },
    {
      "name": "transactionDate",
      "label": "Transaction Date",
      "type": "date",
      "autoPopulate": "date",
      "required": true
    },
    {
      "name": "description",
      "label": "Description",
      "type": "text",
      "required": true
    },
    {
      "name": "category",
      "label": "Category",
      "type": "select",
      "options": ["", "Income", "Expense", "Asset", "Liability"],
      "required": true
    },
    {
      "name": "amount",
      "label": "Amount",
      "type": "number",
      "required": true
    },
    {
      "name": "currency",
      "label": "Currency",
      "type": "select",
      "options": ["", "SSP", "USD", "EUR"],
      "required": true,
      "default": "SSP"
    },
    {
      "name": "notes",
      "label": "Notes",
      "type": "textarea"
    },
    {
      "name": "recordedBy",
      "label": "Recorded By",
      "type": "text",
      "fromUser": "userNameDisplay",
      "readonly": true
    }
  ]
}
